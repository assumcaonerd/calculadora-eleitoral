{
  "name": "calculadora-eleitoral",
  "version": "0.2.0",
  "description": "Motor de cálculo do sistema proporcional brasileiro (quociente eleitoral, quociente partidário e sobras), atualizado com a legislação vigente para 2026",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test dist/tests/engine.test.js && npm run validate:web",
    "validate:web": "node scripts/validate-html.mjs"
  },
  "keywords": [
    "quociente-eleitoral",
    "direito-eleitoral",
    "sistema-proporcional",
    "eleições",
    "brasil",
    "sobras",
    "tse"
  ],
  "author": "assumcaonerd",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.4"
  }
}
